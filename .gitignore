.idea
.claude


# Ignore actual secret files (not templates)
#*-secret.yaml # => is allowed, it is in controlled (demo) environments
!*-secret.yaml.template

# Ignore any files with credentials
*credentials*.yaml
!*credentials*.yaml.template

# Ignore any local overrides
*.local.yaml
/info/environment_config.md
/info/versions.csv
