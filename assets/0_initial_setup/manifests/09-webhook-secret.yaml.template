---
# Template for webhook secrets (GitHub/GitLab webhooks)
# Copy this file to 09-webhook-secret.yaml and fill in your webhook secret
# Then apply with: oc apply -f 09-webhook-secret.yaml
#
# IMPORTANT: Never commit the actual secret file to Git!
# Add 09-webhook-secret.yaml to .gitignore

apiVersion: v1
kind: Secret
metadata:
  name: argocd-webhook-secret
  namespace: openshift-gitops
type: Opaque
stringData:
  # GitHub webhook secret
  # Generate with: openssl rand -hex 20
  github.secret: YOUR_GITHUB_WEBHOOK_SECRET

  # GitLab webhook secret
  gitlab.secret: YOUR_GITLAB_WEBHOOK_SECRET

  # Bitbucket webhook secret
  bitbucket.secret: YOUR_BITBUCKET_WEBHOOK_SECRET

---
# ArgoCD notifications secret (for Slack, email, etc.)
apiVersion: v1
kind: Secret
metadata:
  name: argocd-notifications-secret
  namespace: openshift-gitops
type: Opaque
stringData:
  # Slack token
  slack-token: YOUR_SLACK_BOT_TOKEN

  # Email password
  # email-password: YOUR_EMAIL_PASSWORD

  # GitHub token for notifications
  # github-token: YOUR_GITHUB_TOKEN
