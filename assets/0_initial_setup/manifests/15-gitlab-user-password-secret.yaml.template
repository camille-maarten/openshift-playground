---
# ============================================================================
# GitLab User Configuration Template
# ============================================================================
#
# BEFORE INSTALLATION:
# 1. Copy this file:
#    cp manifests/15-gitlab-user-password-secret.yaml.template manifests/15-gitlab-user-password-secret.yaml
#
# 2. (OPTIONAL) Add your SSH public key below if you want to use SSH for Git
#    - Check for existing key: ls ~/.ssh/id_*.pub
#    - Create new key if needed: ssh-keygen -t ed25519 -C "your-email@example.com"
#    - Display key: cat ~/.ssh/id_ed25519.pub
#    - Copy the output and paste it below (uncomment the line)
#
# 3. (OPTIONAL) You can skip SSH and just use HTTPS with username/password
#
# IMPORTANT: Never commit the actual secret file (without .template) to Git!
#
# ============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: gitlab-user-password
  namespace: gitlab-system
  labels:
    app: gitlab
type: Opaque
stringData:
  # Default user password (used for HTTPS authentication)
  password: gitlab1234!

  # (OPTIONAL) Your SSH public key for Git operations
  # Uncomment and replace with YOUR public key from: cat ~/.ssh/id_ed25519.pub
  # Example: ssh_public_key: ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... your-email@example.com
  #
  # ssh_public_key: PASTE_YOUR_SSH_PUBLIC_KEY_HERE

  # Additional user credentials (optional - for future use)
  # username: developer
  # email: developer@example.com

---
# GitLab SSH Host Keys Secret (optional)
# This secret can be used to persist SSH host keys across GitLab restarts
apiVersion: v1
kind: Secret
metadata:
  name: gitlab-ssh-host-keys
  namespace: gitlab-system
type: Opaque
stringData:
  # SSH host keys will be auto-generated if not provided
  # Uncomment and add your keys if you want to use custom SSH host keys
  # ssh_host_rsa_key: |
  #   -----BEGIN RSA PRIVATE KEY-----
  #   YOUR_RSA_PRIVATE_KEY_HERE
  #   -----END RSA PRIVATE KEY-----
  # ssh_host_ecdsa_key: |
  #   -----BEGIN EC PRIVATE KEY-----
  #   YOUR_ECDSA_PRIVATE_KEY_HERE
  #   -----END EC PRIVATE KEY-----
  # ssh_host_ed25519_key: |
  #   -----BEGIN OPENSSH PRIVATE KEY-----
  #   YOUR_ED25519_PRIVATE_KEY_HERE
  #   -----END OPENSSH PRIVATE KEY-----
