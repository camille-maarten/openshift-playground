---
# Template for Git repository credentials
# Copy this file to 08-git-credentials-secret.yaml and fill in your credentials
# Then apply with: oc apply -f 08-git-credentials-secret.yaml
#
# IMPORTANT: Never commit the actual secret file to Git!
# Add 08-git-credentials-secret.yaml to .gitignore

apiVersion: v1
kind: Secret
metadata:
  name: git-credentials
  namespace: openshift-gitops
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  # GitHub/GitLab username
  username: YOUR_GIT_USERNAME

  # Personal Access Token or password
  password: YOUR_GIT_TOKEN_OR_PASSWORD

  # For SSH-based authentication (alternative to username/password)
  # sshPrivateKey: |
  #   -----BEGIN OPENSSH PRIVATE KEY-----
  #   YOUR_SSH_PRIVATE_KEY_HERE
  #   -----END OPENSSH PRIVATE KEY-----

---
# Alternative: Repository-specific secret with ArgoCD annotations
apiVersion: v1
kind: Secret
metadata:
  name: private-repo-credentials
  namespace: openshift-gitops
  labels:
    argocd.argoproj.io/secret-type: repository
  annotations:
    managed-by: argocd.argoproj.io
type: Opaque
stringData:
  # Repository URL
  url: https://github.com/your-org/your-private-repo

  # Username for HTTPS
  username: YOUR_GIT_USERNAME

  # Password or Personal Access Token for HTTPS
  password: YOUR_GIT_TOKEN

  # OR use SSH key (comment out username/password if using SSH)
  # url: git@github.com:your-org/your-private-repo.git
  # sshPrivateKey: |
  #   -----BEGIN OPENSSH PRIVATE KEY-----
  #   YOUR_SSH_PRIVATE_KEY_HERE
  #   -----END OPENSSH PRIVATE KEY-----
