# Ignore actual secret files (not templates)
manifests/*-secret.yaml
!manifests/*-secret.yaml.template
!manifests/10-admin-password-secret.yaml
!manifests/14-gitlab-root-password-secret.yaml
!manifests/19-gitlab-minio-secret.yaml

# Ignore any files with credentials
manifests/*credentials*.yaml
!manifests/*credentials*.yaml.template

# Ignore any local overrides
*.local.yaml
